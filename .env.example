# Core
WRITAI_ENV=development
# Memory resets default on locally. Uncomment only to opt a dedicated Neo4j demo database in.
# WRITAI_DEMO_RESET_ENABLED=true
WRITAI_GRANT_SECRET=replace-this-for-any-shared-demo
WRITAI_GRANT_TTL_SECONDS=3600
WRITAI_AUTHORITY_THRESHOLD=0.75

# Service URLs
WRITAI_AUTHORITY_URL=http://localhost:8001
WRITAI_AGENT_URL=http://localhost:8002
WRITAI_EXECUTOR_URL=http://localhost:8003
WRITAI_SERVICE_TIMEOUT_SECONDS=5
# Persistent Live Workspace state. This local file contains internal signed grants.
WRITAI_WORKSPACE_STORE=.writai/live-workspaces.json

# Consequential execution: fixture | callwright
# Live Callwright calls stay disabled until a team key and controlled demo number
# are configured. Fixture mode never makes a network request.
WRITAI_EXECUTION_PROVIDER=fixture
CALLWRIGHT_API_KEY=
CALLWRIGHT_BASE_URL=https://api.voygr.tech
CALLWRIGHT_DEMO_PHONE_NUMBER=
CALLWRIGHT_TIMEOUT_SECONDS=15
CALLWRIGHT_ATTEMPT_STORE=.writai/callwright-attempts.json
CALLWRIGHT_POLL_INTERVAL_SECONDS=2
CALLWRIGHT_MAX_POLL_SECONDS=30
CALLWRIGHT_LIVE_CALLS_ENABLED=false

# Graph backend: memory | neo4j
WRITAI_GRAPH_BACKEND=memory
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=writai-demo
NEO4J_DATABASE=neo4j

# LLM extraction via Gemini. Required for Slack intake; the deterministic Examples
# and the canonical CSV proof run on the fixture extractor and need none of this.
# The adapter uses the REST API through httpx, so there is no extra pip install.
# AI Studio issues keys in more than one format (older "AIza...", newer "AQ...").
# Both are fine. The adapter sends x-goog-api-key and falls back to bearer auth once
# on a 401, so the header format cannot silently look like a bad key.
# List the models your key can reach:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#        https://generativelanguage.googleapis.com/v1beta/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=30

# Which extractor the code actually builds: fixture | gemini | venice.
# `fixture` is the default so the Examples and the canonical CSV proof need no
# credentials. An unrecognised value raises rather than silently degrading.
LLM_PROVIDER=fixture

# Venice speaks the OpenAI-compatible chat-completions API through httpx, so no extra
# pip install is required. LLM_MODEL/LLM_BACKUP_MODEL are Venice model slugs, not
# OpenAI ones; the backup is tried once after a transport or 5xx failure, and is
# skipped on 401/403/404 because another model cannot fix a bad key or model name.
# List the slugs your key can reach:
#   curl -H "Authorization: Bearer $VENICE_API_KEY" https://api.venice.ai/api/v1/models
VENICE_API_KEY=
LLM_BASE_URL=https://api.venice.ai/api/v1
LLM_MODEL=openai-gpt-4o-mini-2024-07-18
LLM_BACKUP_MODEL=
# Milliseconds, matching the vendor's naming. Normalised to seconds in config.py.
LLM_TIMEOUT_MS=12000

# ---------------------------------------------------------------------------
# Product build — new keys. Nothing below is required by the existing Examples
# or the canonical CSV proof; every one of them fails closed when unset.
# ---------------------------------------------------------------------------

# Slack intake via Composio. REQUIRED for the product demo.
# Terminology note: Composio v3 uses user_id, not entity_id. Never use "default".
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=
COMPOSIO_SLACK_AUTH_CONFIG_ID=
WRITAI_SLACK_CHANNEL_ID=
# Composio pushes triggers to ONE public URL per project. In local dev use
# `composio dev triggers listen --forward http://localhost:8001/intake/slack`
# instead of exposing a tunnel.
WRITAI_PUBLIC_WEBHOOK_URL=

# Hexclave identity and approval authority. REQUIRED for the product demo.
# Permissions are NOT in the JWT, so every check is a round-trip. Cache it.
HEXCLAVE_API_URL=https://api.hexclave.com/api/v1
HEXCLAVE_PROJECT_ID=
HEXCLAVE_PUBLISHABLE_CLIENT_KEY=
HEXCLAVE_SECRET_SERVER_KEY=
HEXCLAVE_TEAM_ID=
# Private user API key for the human running authenticated CLI approvals.
HEXCLAVE_APPROVER_USER_API_KEY=
HEXCLAVE_PERMISSION_CACHE_TTL_SECONDS=60
# Svix endpoint secret for signed Hexclave authority-change deliveries.
HEXCLAVE_WEBHOOK_SECRET=
# Redacted delivery evidence only; raw webhook bodies are never persisted.
HEXCLAVE_WEBHOOK_EVIDENCE_STORE=.writai/hexclave-webhook-events.json

# Claude Code hook enforcement. REQUIRED for the product demo.
# The hook sends ONLY session_id, tool_name and a timestamp. Never tool input.
WRITAI_HOOK_ENDPOINT=http://localhost:8002/supervisor/sessions
# Per-developer token minted by writ.ai; identifies the session owner to the service.
# Leaving it EMPTY makes every /supervisor/sessions route answer 503
# HOOK_AUTHENTICATION_NOT_CONFIGURED, which denies every session. scripts/demo/
# falls back to a local demo key so a rehearsal still runs; nothing else does.
WRITAI_HOOK_API_KEY=
# Keep this small. Hooks fail OPEN on timeout, so a long timeout silently disables enforcement.
WRITAI_HOOK_TIMEOUT_SECONDS=3
WRITAI_HOOK_CACHE_PATH=.writai/hook-verdict-cache.json

# Callwright backstop for live supervisor interrupts. The scheduler is inert unless
# CALLWRIGHT_LIVE_CALLS_ENABLED=true. The phone ref must resolve through the executor's
# server-owned target allowlist; it is never a raw phone number supplied by a session.
WRITAI_INTERRUPT_ESCALATION_THRESHOLD_SECONDS=300
WRITAI_INTERRUPT_ESCALATION_SCAN_INTERVAL_SECONDS=30
WRITAI_INTERRUPT_ESCALATION_GRANT_STORE=.writai/interrupt-escalation-grants.json
WRITAI_INTERRUPT_ESCALATION_PHONE_REF=demo-venue

# Approval notification channels. Optional; the CLI approve path works without any of them.
WRITAI_PUBLIC_BASE_URL=http://localhost:8001
# HMAC secret for signed, single-use approval links. Must differ from WRITAI_GRANT_SECRET.
WRITAI_APPROVAL_LINK_SECRET=
# Short-lived bearer links are consumed durably before any approval attempt.
WRITAI_APPROVAL_LINK_TTL_SECONDS=900
WRITAI_APPROVAL_LINK_STORE=.writai/approval-link-uses.sqlite3
WRITAI_APPROVAL_ASSERTION_STORE=.writai/approval-assertion-uses.sqlite3
# Server-owned per-Workspace Hexclave identity -> destination allowlist.
# Example: {"schema_version":1,"recipients":[{"workspace_id":"csv-exports","approver_user_id":"hex-compliance","email":"lead@example.com","ntfy_topic":"writai-7F3k9Q2mR8xP4vN6cL1s","pushover_user_key":"user-key"}]}
WRITAI_APPROVAL_RECIPIENT_BINDINGS=
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# Required for ntfy approval delivery.
NTFY_ACCESS_TOKEN=
# Set true only after reserving the topic or configuring server ACL/default-deny
# so anonymous subscribers cannot read it. A high-entropy topic is also required.
NTFY_PRIVATE_TOPIC_CONFIRMED=false
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
RESEND_API_KEY=
WRITAI_EMAIL_FROM=

# Superset — demo infrastructure only, never a runtime dependency.
SUPERSET_API_KEY=

# CrustData — stretch beat (approver changed role or left the company).
CRUSTDATA_API_KEY=
CRUSTDATA_API_VERSION=2025-11-01
# CrustData documents no webhook signing; authenticate deliveries with your own bearer header.
CRUSTDATA_WEBHOOK_BEARER=
# Operator-only replay credential. It must be non-empty and different from the webhook bearer.
CRUSTDATA_REPLAY_BEARER=
# Server-owned CrustData person -> Hexclave user mapping. Never infer this from names or titles.
# Example: {"schema_version":1,"people":[{"crustdata_person_id":6324687,"hexclave_user_id":"hex-user-id","evidence_ref":"provisioning://crustdata/person/6324687"}]}
CRUSTDATA_PERSON_IDENTITY_BINDINGS=
# Minimized callback deliveries are captured here with owner-only permissions.
CRUSTDATA_CAPTURE_DIR=.writai/crustdata-captures

# Frontend
VITE_AUTHORITY_URL=http://localhost:8001
VITE_AGENT_URL=http://localhost:8002
VITE_EXECUTOR_URL=http://localhost:8003
# Public browser configuration; never put a secret or user API key in VITE_*.
VITE_HEXCLAVE_PROJECT_ID=
VITE_WRITAI_HEXCLAVE_SIGN_IN=0
